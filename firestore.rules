rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 목록: 문서 ID = 관리자 이메일(예: super@simkung.admin), 필드 role = 'super' 또는 'manager'
    // 본인 문서만 읽을 수 있고, 쓰기는 Firebase 콘솔에서만 가능합니다.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    match /chars/{id} {
      function role() {
        return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
          ? get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role
          : '';
      }
      function ok() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.nick.size() <= 30
          && request.resource.data.ph is string
          && request.resource.data.ph.size() == 64
          && request.resource.data.salt is string
          && request.resource.data.salt.size() <= 40
          && request.resource.data.keys().hasOnly(['name','nick','ho','mj','bi','gk','bb','bo','bs','hs','bj','bm','bt','ts','salt','ph','memo']);
      }
      allow read: if true;
      allow create: if ok();
      // 수정: 비밀번호 해시(ph, salt)는 바꿀 수 없습니다. 단, 슈퍼관리자는 비밀번호 초기화를 위해 바꿀 수 있습니다.
      allow update: if ok()
          && ((request.resource.data.ph == resource.data.ph
               && request.resource.data.salt == resource.data.salt)
              || role() == 'super');
      // 삭제: 방문자는 화면에서 비밀번호를 확인한 뒤 삭제합니다(서버는 비밀번호를 검사하지 못합니다). 슈퍼관리자는 비밀번호 없이 삭제합니다.
      allow delete: if true;
    }
  }
}
